rules_version = '2';

// ============================================================
//  Морьтон Адууны Төв — Firebase Storage хамгаалалтын дүрэм
// ------------------------------------------------------------
//  Апп зөвхөн ХОЁР зам руу зураг байршуулдаг:
//    exam-images/{үзлэгийн id}/{зургийн id}.jpg   — үзлэгийн зураг (app.js)
//    lab-results/{шинжилгээний id}/{зургийн id}.jpg — шинжилгээний хариу (lab.js)
//
//  ⚠️ Энэ файлыг Firebase Console → Build → Storage → Rules хэсэгт
//     БҮТНЭЭР нь буулгаад Publish дарна. (Firestore Database → Rules
//     БИШ — тэнд буулгавал зураг дээр огт нөлөөлөхгүй.)
//
//  Санаатайгаар ЭНГИЙН бичсэн: туслах функц, файлын төрлийн шалгалт
//  байхгүй. Урьд нь contentType шалгадаг хувилбар байсан бөгөөд тэр нь
//  зарим тохиолдолд хүсэлтийг санамсаргүй хаах эрсдэлтэй байсан.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Үзлэгийн зураг
    match /exam-images/{examId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Шинжилгээний хариу
    match /lab-results/{labId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Бусад бүх зам — хаалттай
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
